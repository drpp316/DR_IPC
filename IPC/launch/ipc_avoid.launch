<launch>
    <arg name="start_rqt_plot" default="true"/>
    <arg name="start_marsim" default="true"/>
    <arg name="start_odom_vis" default="true"/>
    <arg name="init_x" default="0.0"/>
    <arg name="init_y" default="0.0"/>
    <arg name="init_z" default="1.0"/>
    <arg name="init_yaw" default="0.0"/>

    <!-- IPC2 now drives MARS directly with /mavros/setpoint_raw/attitude.
         Therefore ipc_avoid.launch must start the MARS quadrotor dynamics,
         not the old perfect_tracker used by the /planning/pos_cmd chain. -->
    <node if="$(arg start_marsim)"
          pkg="nodelet"
          type="nodelet"
          name="manager"
          args="manager"
          output="screen">
        <param name="num_worker_threads" value="16"/>
    </node>

    <node if="$(arg start_marsim)"
          pkg="nodelet"
          type="nodelet"
          name="so3_quadrotor"
          args="load so3_quadrotor/Nodelet manager"
          output="screen">
        <rosparam file="$(find test_interface)/config/so3_quadrotor.yaml"/>
        <param name="init_x" value="$(arg init_x)"/>
        <param name="init_y" value="$(arg init_y)"/>
        <param name="init_z" value="$(arg init_z)"/>
        <param name="init_yaw" value="$(arg init_yaw)"/>
        <remap from="~odom" to="/lidar_slam/odom"/>
        <remap from="~bodyrate_cmd" to="/mavros/setpoint_raw/attitude"/>
        <remap from="~so3cmd" to="/so3_cmd"/>
        <remap from="~imu" to="/lidar_slam/imu"/>
        <remap from="~vis" to="/vis"/>
    </node>

    <node if="$(arg start_odom_vis)"
          pkg="odom_visualization"
          type="odom_visualization"
          name="odom_visualization"
          output="screen">
        <remap from="~odom" to="/lidar_slam/odom"/>
        <param name="mesh_resource" value="package://odom_visualization/meshes/yunque-M.dae"/>
        <param name="tf45" value="true"/>
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="1.0"/>
        <param name="color/g" value="1.0"/>
        <param name="color/b" value="1.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="1.0"/>
    </node>

    <node pkg="ipc2" type="ipc2_node" name="ipc2_node" output="screen">
        <!-- publish topic -->
        <remap from="cmd"          to="/planning/pos_cmd"/>
        <remap from="so3cmd_out"   to="/so3_cmd"/>
        <remap from="astar_path"   to="/astar/path"/>
        <remap from="grid_map"     to="/astar/grid_map"/>
        <remap from="sfc"          to="/mkr_arr"/>
        <remap from="mpc_path"     to="/mpc/path"/>
        <remap from="px4ctrl"      to="/mavros/setpoint_raw/attitude"/>
        <remap from="goal_pub"     to="/mpc/goal"/>
        
        <!-- subscribe topic -->
        <remap from="local_pc"     to="/pcl_render_node/cloud"/>
        <remap from="odom"         to="/lidar_slam/odom"/>
        <remap from="imu"          to="/lidar_slam/imu"/>
        <remap from="goal"         to="/goal"/>
        <remap from="rc_in"        to="/mavros/rc/in"/>

        <rosparam command="load" file="$(find ipc2)/config/param_avoid.yaml"/>

    </node>

    <node name="ipc2" pkg="rviz" type="rviz" args="-d $(find ipc2)/config/fast_obs.rviz"/>
    <node if="$(arg start_rqt_plot)"
          name="ipc2_rqt_plot"
          pkg="rqt_plot"
          type="rqt_plot"
          output="screen"
          args="/disturbance_hat/vector/x /disturbance_hat/vector/y /disturbance_hat/vector/z"/>
    <node if="$(arg start_rqt_plot)"
          name="ipc2_rqt_plot_height"
          pkg="rqt_plot"
          type="rqt_plot"
          output="screen"
          args="/lidar_slam/odom/pose/pose/position/z"/>

</launch>
